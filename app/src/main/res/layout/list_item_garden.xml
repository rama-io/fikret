<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/garden_list_item"
    style="@style/HorizontalList"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        style="@style/VerticalList"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/harvest_btn"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:background="@drawable/px_circle"
            android:backgroundTint="?attr/iconBg"
            android:padding="16dp">

            <ImageView
                android:id="@+id/garden_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/garden_count"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:textSize="12sp" />
    </LinearLayout>

    <View style="@style/SeparatorListHorizontal" />

    <LinearLayout
        style="@style/VerticalList"
        android:layout_width="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/HorizontalList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/progress_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_garden" />

                <TextView
                    android:id="@+id/product_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/base"
                    android:textSize="12dp" />
            </FrameLayout>
        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <LinearLayout
            style="@style/HorizontalList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/buy_button"
                style="@style/VerticalList"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="4dp">

                <TextView
                    android:id="@+id/buy_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/base"
                    android:textSize="12dp" />

                <TextView
                    android:id="@+id/buy_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/base"
                    android:textSize="12dp" />
            </LinearLayout>

            <View style="@style/SeparatorListHorizontal" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="?attr/timeBg"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/buy_bird_gap"
        style="@style/SeparatorListHorizontal" />

    <FrameLayout
        android:id="@+id/buy_bird_btn"
        android:layout_width="45dp"
        android:layout_height="65dp"
        android:background="?attr/iconBg"
        android:contentDescription="@string/buyer_toggle_desc"
        android:padding="8dp">

        <ImageView
            android:id="@+id/bird_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
