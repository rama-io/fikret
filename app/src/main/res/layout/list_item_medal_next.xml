<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/VerticalList"
    android:background="@color/surface_1"
    android:gravity="center"
    android:padding="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="@string/tile_next"
        android:textColor="@color/text"
        android:textSize="@dimen/small" />

    <TextView
        android:id="@+id/medal_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/warning"
        android:textSize="@dimen/small" />

    <TextView
        android:id="@+id/medal_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/warning"
        android:textSize="@dimen/small" />

    <View style="@style/SeparatorListVertical" />

    <TextView
        android:id="@+id/time_counter"
        style="@style/BlockFlow"
        android:background="@color/surface_0"
        android:ellipsize="end"
        android:gravity="center"
        android:padding="4dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="@dimen/small" />

    <Button
        android:id="@+id/buy_next"
        style="@style/BlockFlow"
        android:background="@color/btnBg"
        android:ellipsize="end"
        android:gravity="center"
        android:padding="4dp"
        android:singleLine="true"
        android:text="@string/tile_buy"
        android:textColor="@color/base"
        android:textSize="@dimen/small"
        android:visibility="gone" />
</LinearLayout>
