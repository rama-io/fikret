<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.rama.fikret.widgets.WdCollapsibleSection
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:defaultExpanded="true"
        app:header="Lake"
        app:key="settings:section:system">

        <TextView
            style="@style/Text"
            android:text="Summary" />

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/VerticalList_BG2">

            <LinearLayout
                android:id="@+id/gain_base"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/gain_base_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Base" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar_fill_base"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_garden" />

                    <TextView
                        android:id="@+id/bar_percent_base"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/base"
                        android:textSize="@dimen/small" />
                </FrameLayout>

                <TextView
                    android:id="@+id/gain_base_value"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="DOP 2.48e10" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/gain_upgrades"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/gain_upgrades_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Upgrades" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar_fill_upgrades"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_garden" />

                    <TextView
                        android:id="@+id/bar_percent_upgrades"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/base"
                        android:textSize="@dimen/small" />
                </FrameLayout>

                <TextView
                    android:id="@+id/gain_upgrades_value"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="DOP 2.48e10" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/gain_milestones"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/gain_milestones_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Milestones" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar_fill_milestones"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_garden" />

                    <TextView
                        android:id="@+id/bar_percent_milestones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/base"
                        android:textSize="@dimen/small" />
                </FrameLayout>

                <TextView
                    android:id="@+id/gain_milestones_value"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="DOP 2.48e10" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/gain_farm_points"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/gain_farm_points_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Farm Points" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar_fill_farm_points"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_garden" />

                    <TextView
                        android:id="@+id/bar_percent_farm_points"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/base"
                        android:textSize="@dimen/small" />
                </FrameLayout>

                <TextView
                    android:id="@+id/gain_farm_points_value"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="DOP 2.48e10" />
            </LinearLayout>
            
        </LinearLayout>

        <TextView
            style="@style/Text"
            android:text="Gardens" />

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/VerticalList_BG2">

            <LinearLayout
                android:id="@+id/gain_guanabana"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/gain_guanabana_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Gain per Second" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/bar_fill_guanabana"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_garden" />

                    <TextView
                        android:id="@+id/bar_percent_guanabana"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/base"
                        android:textSize="@dimen/small" />
                </FrameLayout>

                <TextView
                    android:id="@+id/gain_guanabana_value"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="DOP 2.48e10" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <!-- rest of the gardens here -->

        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <TextView
            style="@style/Text"
            android:text="Ascension" />

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/VerticalList_BG2">

            <LinearLayout
                android:id="@+id/farm_points"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/farm_points_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Farm Points" />

                <TextView
                    android:id="@+id/farm_points_value"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="100" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/farm_points_profit"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/farm_points_profit_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Farm Points Profit" />

                <TextView
                    android:id="@+id/farm_points_profit_value"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="+394%" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/Text"
            android:text="Best Buy" />

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/VerticalList_BG2">

            <TextView
                android:id="@+id/best_buy_label"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:text="Yautia Speed x2" />

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/afford_timer"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/afford_timer_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="You can afford it in:" />

                <TextView
                    android:id="@+id/afford_timer_value"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="1:00:11" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/pays_back"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/pays_back_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Pays back in:" />

                <TextView
                    android:id="@+id/pays_back_value"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="1:00:11" />
            </LinearLayout>

        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <TextView
            style="@style/Text"
            android:text="Total" />

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/VerticalList_BG2">

            <LinearLayout
                android:id="@+id/gain_second"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/gain_second_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Gain per Second" />

                <TextView
                    android:id="@+id/gain_second_value"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="DOP 2.48e10" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/gain_minute"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/gain_minute_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Gain per Minute" />

                <TextView
                    android:id="@+id/gain_minute_value"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="DOP 2.48e10" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/gain_hour"
                style="@style/HorizontalList">

                <TextView
                    android:id="@+id/gain_hour_label"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="Gain per Hour" />

                <TextView
                    android:id="@+id/gain_hour_value"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="DOP 2.48e10" />
            </LinearLayout>
        </LinearLayout>
    </com.rama.fikret.widgets.WdCollapsibleSection>
</LinearLayout>