<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/VerticalList">

    <View
        android:id="@+id/bar_gap"
        style="@style/SeparatorListVertical" />

    <LinearLayout style="@style/HorizontalList">

        <TextView
            android:id="@+id/bar_label"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="@dimen/small" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/bar_fill"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_garden" />

            <TextView
                android:id="@+id/bar_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/base"
                android:textSize="@dimen/small" />
        </FrameLayout>

        <TextView
            android:id="@+id/bar_value"
            android:layout_width="108dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="@dimen/small" />
    </LinearLayout>
</LinearLayout>
