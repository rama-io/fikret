<?xml version="1.0" encoding="utf-8"?>
<com.rama.fikret.widgets.WdCollapsibleSection xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/farm_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:defaultExpanded="true">

    <LinearLayout
        android:id="@+id/farm_best_group"
        style="@style/VerticalList">

        <TextView
            style="@style/Text"
            android:text="@string/finance_best_buy_title" />

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/VerticalList_BG2">

            <Button
                android:id="@+id/best_buy_name"
                style="@style/BTN" />

            <View style="@style/SeparatorListVertical" />

            <LinearLayout style="@style/HorizontalList">

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="@string/finance_afford_in" />

                <TextView
                    android:id="@+id/afford_timer"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="end" />
            </LinearLayout>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout style="@style/HorizontalList">

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:text="@string/finance_pays_back" />

                <TextView
                    android:id="@+id/pays_back"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View style="@style/SeparatorListVertical" />

    <TextView
        style="@style/Text"
        android:text="@string/finance_summary" />

    <View style="@style/SeparatorListVertical" />

    <LinearLayout
        android:id="@+id/farm_sources"
        style="@style/VerticalList_BG2" />

    <View style="@style/SeparatorListVertical" />

    <TextView
        style="@style/Text"
        android:text="@string/finance_gardens" />

    <View style="@style/SeparatorListVertical" />

    <LinearLayout
        android:id="@+id/farm_gardens"
        style="@style/VerticalList_BG2" />

    <View style="@style/SeparatorListVertical" />

    <TextView
        style="@style/Text"
        android:text="@string/finance_total" />

    <View style="@style/SeparatorListVertical" />

    <LinearLayout style="@style/VerticalList_BG2">

        <LinearLayout style="@style/HorizontalList">

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:text="@string/finance_gain_second" />

            <TextView
                android:id="@+id/gain_second"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/HorizontalList">

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:text="@string/finance_gain_minute" />

            <TextView
                android:id="@+id/gain_minute"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/HorizontalList">

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:text="@string/finance_gain_hour" />

            <TextView
                android:id="@+id/gain_hour"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

    </LinearLayout>

    <View style="@style/SeparatorListVertical" />

    <TextView
        style="@style/Text"
        android:text="@string/finance_ascension" />

    <View style="@style/SeparatorListVertical" />

    <TextView
        style="@style/Text"
        android:text="@string/ascend_warning"
        android:textColor="@color/disabled" />

    <View style="@style/SeparatorListVertical" />

    <LinearLayout style="@style/VerticalList_BG2">

        <LinearLayout style="@style/HorizontalList">

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:text="@string/finance_farm_points" />

            <TextView
                android:id="@+id/farm_points"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/HorizontalList">

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:text="@string/finance_farm_points_profit" />

            <TextView
                android:id="@+id/farm_points_profit"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <LinearLayout style="@style/HorizontalList">

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:text="@string/finance_farm_points_gain" />

            <TextView
                android:id="@+id/farm_points_gain_on_ascend"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <Button
            android:id="@+id/ascend_confirm"
            style="@style/BTN"
            android:text="@string/ascend_confirm" />

    </LinearLayout>
</com.rama.fikret.widgets.WdCollapsibleSection>
