<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/HorizontalList"
    android:background="@color/base">

    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/px_circle"
        android:backgroundTint="?attr/iconBg"
        android:padding="10dp">

        <ImageView
            android:id="@+id/manager_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <View style="@style/SeparatorListHorizontal" />

    <LinearLayout
        style="@style/VerticalList"
        android:layout_width="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/manager_name"
            style="@style/H3"
            android:singleLine="true" />

        <TextView
            android:id="@+id/manager_description"
            style="@style/Text"
            android:textColor="@color/subtle" />
    </LinearLayout>

    <View style="@style/SeparatorListHorizontal" />

    <LinearLayout
        android:id="@+id/rescue_button"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:background="?attr/accent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/rescue_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rescue"
            android:textColor="@color/base" />

        <TextView
            android:id="@+id/rescue_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/base"
            android:textSize="@dimen/small" />
    </LinearLayout>

</LinearLayout>
